{
  "name": "@zilo/license-gate",
  "version": "0.0.0",
  "description": "Default-deny licence gate for the web workspace's npm dependency graph.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run"
  }
}
