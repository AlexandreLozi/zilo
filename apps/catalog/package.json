{
  "name": "@zilo/catalog",
  "version": "0.0.0",
  "description": "Zilo component catalog: one page per component state and theme; the axe and keyboard E2E target.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check . --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@zilo/ui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@zilo/react": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
