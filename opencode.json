{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "external_directory": "allow",
    "doom_loop": "allow"
  },
  "model": "openai/gpt-6.1-sol",
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "agent": {
    "orchestrator": {
      "model": "openai/gpt-6.1-sol",
      "variant": "high"
    },
    "build": {
      "model": "openai/gpt-6.1-sol",
      "variant": "medium"
    }
  }
}
