<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <NuGetLockFilePath>locks/$(RuntimeIdentifier).packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAPS2.Sdk" Version="[1.6.0]" />
    <PackageReference Include="SixLabors.Fonts" Version="[1.0.1]" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PackageReference Include="NAPS2.Images.Gdi" Version="[1.6.0]" />
    <PackageReference Include="NAPS2.Sdk.Worker.Win32" Version="[1.6.0]" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <PackageReference Include="NAPS2.Images.Mac" Version="[1.6.0]" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <PackageReference Include="NAPS2.Images.Gtk" Version="[1.6.0]" />
  </ItemGroup>
  <Target Name="RequireExplicitRid" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(RuntimeIdentifier)' == ''" Text="Specify -p:RuntimeIdentifier=RID (dotnet restore -r alone does not select platform references)." />
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' and '$(RuntimeIdentifier)' != 'win-arm64' and '$(RuntimeIdentifier)' != 'osx-arm64' and '$(RuntimeIdentifier)' != 'osx-x64' and '$(RuntimeIdentifier)' != 'linux-x64'" Text="This spike inventories only win-x64, win-arm64, osx-arm64, osx-x64, linux-x64." />
  </Target>
</Project>
