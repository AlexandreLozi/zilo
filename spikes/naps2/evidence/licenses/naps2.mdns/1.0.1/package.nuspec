<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>NAPS2.Mdns</id>
    <version>1.0.1</version>
    <title>Multicast DNS</title>
    <authors>Ben Olden-Cooligan</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/cyanfish/net-mdns</projectUrl>
    <description>Fork of Makaretu.Dns.Multicast.New for NAPS2.Escl</description>
    <tags>naps2 mdns</tags>
    <repository type="git" commit="9a1b989ff57738849ceda165de49cc76364e8ace" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="Makaretu.Dns" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net6.0">
        <dependency id="Makaretu.Dns" version="2.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Makaretu.Dns" version="2.0.1" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>