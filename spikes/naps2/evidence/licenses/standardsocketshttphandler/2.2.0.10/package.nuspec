<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>StandardSocketsHttpHandler</id>
    <version>2.2.0.10</version>
    <authors>Tal Aloni</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <projectUrl>https://github.com/TalAloni/StandardSocketsHttpHandler</projectUrl>
    <description>StandardSocketsHttpHandler is a backport of SocketsHttpHandler to .NET Standard 2.0</description>
    <repository type="git" url="https://github.com/TalAloni/StandardSocketsHttpHandler" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Memory" version="4.5.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1" />
    </dependencies>
  </metadata>
</package>